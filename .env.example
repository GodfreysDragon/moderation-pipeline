APP_NAME="Moderation Pipeline"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Moderation (set MODERATION_CLASSIFIER=fake to run without an API key)
MODERATION_CLASSIFIER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
MODERATION_AI_CALLS_PER_MINUTE=30
MODERATION_AUDIT_SAMPLE_RATE=0.05
MODERATION_SECOND_REVIEW_RATE=0.1
MODERATION_GRAPHIC_DAILY_LIMIT=40
MODERATION_RETENTION_DAYS=30
MODERATION_EVALUATION_POLL_SECONDS=60
MODERATION_WEBHOOKS_ALLOW_PRIVATE=false
MODERATION_BACKLOG_ALERT_MINUTES=60

# Live updates. These keys only identify the app to your own Reverb server
# (php artisan reverb:start, part of composer run dev); generate real ones for
# production with php artisan reverb:install. BROADCAST_CONNECTION=log turns
# live updates off and the pages fall back to polling.
REVERB_APP_ID=moderation-local
REVERB_APP_KEY=moderation-local-key
REVERB_APP_SECRET=moderation-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
